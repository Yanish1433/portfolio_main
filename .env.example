# Web3Forms access key for the contact form (public by design; get one free at web3forms.com).
# On the live host (Cloudflare) set this variable at BUILD time, or the deployed form shows "not set up".
NEXT_PUBLIC_WEB3FORMS_KEY=

# Guestbook (Supabase REST, public by design: the table's RLS + column grants are the protection).
# Set both at BUILD time on the host too (NEXT_PUBLIC_* values are inlined into the bundle). Empty = guestbook hidden, flags stay empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
